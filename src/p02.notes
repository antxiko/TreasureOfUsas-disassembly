L 0x881C anota_cc40 anota el registro de HL en el primer hueco de 0xCC40
L 0x882E hueco_cc40 DE = el primer hueco libre de 0xCC40 (4 de 4 bytes)
L 0x886A recorre_cc40 los 4 registros de 0xCC40
L 0x887F registro_cc40 un registro [Y][X][tipo][..] de 0xCC40
L 0x88F7 cuenta_cc39 0xCC3D = 2 y 0xCC39 - 1
L 0x8903 cuenta_cc36 0xCC3D = 3, 0xCC36 - 1 y el siguiente de 0xCC37 (0-3)
L 0x8977 espera_cc3c (HL) = 0x30 o 0x60 segun 0xCC3C
L 0x8983 lado_del_personaje D = L si la X del personaje es < 0x80, si no H
L 0x89CD dibujo_cc35 copia 24 x 16 de la fila 0xCC35 con TIMP (0x40)
L 0x8A09 dibujo_cc35_doble p02:89CD y dos piezas mas de (0x80, 0x38) y (0x98, 0x38)
L 0x8A19 copia_24x8 copia 24 x 8 de (H, 0x38) a (D, E) con TIMP
L 0x8A23 origen_cc35 HL = (0xB0, 0x90 + 0xCC35 * 16)
L 0x8A30 desplaza_8_20 D + 8 y E + 0x14
L 0x8A39 fotograma_del_actor con 15: el fotograma (ix+0x10) del actor (p02:8A42)
L 0x8A42 piezas_del_fotograma la posicion y el patron de cada pieza del fotograma (p15:B744)
L 0x8AB8 sprites_de_piezas los atributos de cada pieza del actor en 0xDE28
