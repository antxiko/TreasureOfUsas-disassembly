L 0x5396 sprites_del_tipo los patrones del tipo A de p15:ADDA a la VRAM (p00:4926)
L 0x53A0 patrones_b511 con 13-14-15: el RLE de p15:B511 a la VRAM 0xFFC0
L 0x53AF lista_af78 con 4-5-6: la lista p06:AF78
L 0x53BB lista_af81 con 10-11-12: la lista p12:AF81
L 0x53C7 paleta_de_fase p06:B335 y la paleta de la ruina (p06:B2DB), o la de la sala 5 (p06:B35C)
L 0x53DE paleta_base con 4-5-6: la paleta p06:B335
L 0x53E6 paleta_b550 con 4-5-6: la paleta p06:B550
L 0x53EC paleta_y_vuelve p00:4A9D y vuelve con 1-2-3
L 0x5400 paleta_vacia fuera de la sala 5: la paleta p06:B35B (vacia)
L 0x540D paleta_de_antesala p06:B271 y la de la ruina (p06:B281)
L 0x543A palabra_a HL = la palabra A de la tabla HL
L 0x5443 esconde_sprites_ram Y = 0xE0 en los 32 atributos de 0xDE00
L 0x5464 bancos_1_2_3 pone los bancos 1-2-3 y su copia en 0xF0F1-0xF0F3
L 0x547E bancos_4_5_6 pone los bancos 4-5-6 (p00:5490)
L 0x5483 bancos_7_8_9 pone los bancos 7-8-9 (p00:5490)
L 0x5488 bancos_10_11_12 pone los bancos 10-11-12 (p00:5490)
L 0x548D bancos_13_14_15 pone los bancos 13-14-15 y su copia
L 0x54A5 banco_15_en_a000 pone el banco 15 en 0xA000 (p00:54B9)
L 0x54AA banco_12_en_a000 pone el banco 12 en 0xA000
