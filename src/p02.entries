0x8AFF   # p03:B40E call cc
0x8B0B   # sin entrada: ld a,0x0F y cae en p02:8B0D
0x8B1D   # p03:AFD9 call
0x8B27   # p03:AFCE call
0x8B31   # p03:A63C call cc
0x8B41   # p03:B404 call
0x8B4F   # p03:B005 call
0x8B68   # sin entrada: B + 2 si el bit 0 de (ix+0x17) esta puesto, y cae en p02:8B70
0x8B7E   # p03:A8B5 jp
0x8B80   # p03:A5A5 call
0x8B82   # p03:A651 jp
