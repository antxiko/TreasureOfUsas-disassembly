L 0x8B8B velocidad_x_h (ix+9, 0x0A) = H * 256 (L = 0)
L 0x8B8D pon_velocidad_x (ix+9, 0x0A) = HL
L 0x8B94 pon_aceleracion_x (ix+0x0E, 0x0F) = HL
L 0x8B9B pon_aceleracion_y (ix+0x0C, 0x0D) = HL
L 0x8BA9 para_actor velocidades a cero
