# --- A MANO: comentarios, nombres y bloques ---
C 0xB8F5 la tabla de la fase; 2 bytes por pantalla (0xC212 - 1)
C 0xB908 los nibbles de cada byte: primero el alto
C 0xB8D2 + lado - 1: la vecina de ese lado
C 0xB8D9 0xFF: sin vecina, nada
C 0xB8DC 0: el lado lleva fuera de la fase
C 0xB8DF la vecina es la pantalla nueva
C 0xB8E3 0xC226 = 1: se sale de la fase
C 0xB8EC 2 bytes por fase en p09:B921
C 0xB8F8 HL = la tabla de la fase
C 0xB8F9 la pantalla - 1...
C 0xB8FD ...* 2 bytes
C 0xB906 4 vecinas: arriba, abajo, izquierda y derecha
C 0xB909 con B par (4 y 2), el nibble alto
C 0xB911 el nibble
C 0xB913 0x0F: sin vecina (0xFF)
C 0xB919 a 0xC218 + lado
C 0xB91B tras el nibble bajo, el byte siguiente

# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0xB8CC pantalla_vecina 0xC212 = la vecina del lado 0xC215 (0xC218-0xC21B)
L 0xB8E9 vecinas_de_la_pantalla las cuatro vecinas de la pantalla de p09:B921[0xC211] a 0xC218-0xC21B
C 0xB8CC lee el lado por el que se sale (1 arriba, 2 abajo, 3 izquierda, 4 derecha)
C 0xB8CF apunta a la vecina de arriba
C 0xB8E5 guarda se sale de la fase
C 0xB8E9 lee la fase (1-25: ruina * 5 + puerta)
C 0xB903 apunta a la vecina de arriba
# --- fin de las anotaciones de anota.py ---
