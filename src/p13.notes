L 0x6142 canal_musica_3 IX = 0xC06C y p13:6146
L 0x6146 canal_de_musica un cuadro de un canal de musica: cuenta la nota y lee la pista
L 0x6188 vibrato el vibrato del canal ((ix+0x14), (ix+0x15))
L 0x61DE periodo_si_suena p13:60B9 si el canal no esta tapado (bit 5)
L 0x6203 lee_pista el siguiente byte de la pista: nota, silencio u orden (>= 0xD0)
L 0x636B orden_de_pista las ordenes 0xD0-0xFF de la pista
L 0x64D7 canal_40_1 IX = 0xC01C y p13:64ED
L 0x64DD canal_40_2 IX = 0xC044 y p13:64ED
L 0x64E3 canal_40_3 IX = 0xC06C y p13:64ED
L 0x64E9 canal_de_efectos IX = 0xC094 y p13:64ED
L 0x64F4 lee_envolvente un paso de la envolvente o del efecto de (ix+0x0C)
