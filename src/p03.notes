# --- A MANO: comentarios, nombres y bloques ---
C 0xA208 cada 0x20 cuadros escoge una direccion
C 0xA210 al azar: R (el refresco del Z80) xor la cuenta de cuadros
C 0xA218 0 no se mueve; 1-3, una de tres; con el bit 2, tres mas
C 0xA2B5 (ix+0x1F) cuenta las vueltas: hasta 6, espera de 0x40 cuadros
C 0xA2C8 despues, cada 8 cuadros con (ix+0x1E) = 1, hasta 0x18 vueltas
C 0xA32A cada 0x30 cuadros, una direccion al azar de 3 a 6 (sin el 5)
C 0xA450 las tres partes en la posicion (ix+0x1D/0x1E) + 8
C 0xA468 3 grupos de 4 bytes, saltando uno entre grupo y grupo
C 0xA495 cada parte: tres bytes a su sitio, y 8 atras para la siguiente
C 0xA4BD despues se mueve y la cabeza queda en (ix+0x1D/0x1E) + 8 con su fotograma
C 0xA4F0 (ix+0x1B) 3: direccion 4; 4: direccion 0; 1: p03:A51E
C 0xA508 si no, la Y + p03:A530[(ix+0x1F)]
C 0xA83E el primer hueco libre (0) de los 4 de 0xCC60; C su numero
C 0xA846 ninguno: acarreo
C 0xA8ED (ix+0x7E) + 1; si (ix+0x7F) es cero, - 1 en total
C 0xAC7F (ix+0x7F) * 4: el registro de p03:ACB9 ([dx][dy] y el paso)
C 0xAC8F 7 casillas en esa linea
C 0xAC95 cada una: hay suelo (p02:8BB7, bit 3 de (ix+0x16))?
C 0xACA9 lo junta en (ix+0x7D) y pasa a la siguiente
C 0xAFD9 la distancia (p02:8B1D): menos de 0x10, -4; menos de 0x50, -7; si no, -0x0B
C 0xB130 baja de 0x10 en 0x10 hasta 0xC8
C 0xB211 C filas de B fichas de (DE) al mapa (HL) y a la pantalla (p00:4DB4)
C 0xB220 la siguiente fila: 32 casillas mas alla y 8 lineas mas abajo
C 0xB2A6 0xC2A6 cambia: el globo sube o baja
C 0xB2AE 0x28 por encima del personaje
C 0xB2B6 el patron 0x28 o 0x2C
C 0xB4FB B copias de 16 x 8 de la pagina 1 a la 1 (A = 5)
C 0xB509 la siguiente: 8 lineas mas abajo y 16 a la derecha en el origen
C 0xB6FE el byte 2 de (DE)
C 0xB70A el byte 3 de (DE), sin tocar DE
C 0xB82B si no esta cerrada la derecha (0xCCB2): (HL) + C
C 0xB834 si no esta cerrada la izquierda (0xCCB1): (HL) - C
C 0xB8DD la siguiente de las 7 plataformas, 3 bytes mas alla
C 0xB9EA (HL) - B; a cero o por debajo, p03:BA52
C 0xB9F1 si queda algo, p01:730F
C 0xBC41 cada 8 cuadros de (ix+0x11), 1 o 2
C 0xBEC7 B bytes de A en HL y en DE
C 0xAC81 el registro de la direccion en p03:ACB9
C 0xAC91 (ix+0x7D) a cero: ninguna casilla todavia
C 0xA495 cada parte del cuerpo copia la posicion de la anterior: 3 bytes y 8 atras
C 0xA4A9 lo mismo con la segunda tira de partes
C 0xA4BD despues se mueve la cabeza
C 0xA4C0 su sitio, (ix+0x1D/0x1E) + 8, y su fotograma en la primera parte
C 0xACAF el siguiente paso de la linea: + dx y + dy

# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0xA0E2 espera_al_azar (ix+0x11) = el numero del actor * 16 + un numero al azar
L 0xA0FA alterna_79_7b cada 4 cuadros, el fotograma alterna con 0x79 o 0x7B segun (ix+0x1C)
L 0xA115 salto_al_azar guarda la X en (ix+0x1F) y escoge al azar hacia donde ir
L 0xA18C fotograma_7a_7c en cuadros pares, el fotograma de 0x7A7D / 0x7C7E segun (ix+0x1C)
L 0xA1D8 espera_por_estado (ix+0x11) = 0x20, 0x10 u 8 segun el estado del personaje
L 0xA2AB cerca_en_x si A + 0x20 < 0x40: D = la X del personaje
L 0xA2B5 vueltas_1f (ix+0x1F) + 1; hasta 6: (ix+0x11) = 0x40 y (ix+0x1E) = 0
L 0xA2DB velocidad_por_1e 0xC313 = -(0xC0, 0xE0 o 0) y p00:55AA
L 0xA314 crea_tipo_3b 0xC313 = A y crea el actor 0x3B
L 0xA390 plantilla_aebc la plantilla (ix+0x1F) * 11 de p06:AEBC (p00:5596)
L 0xA441 posiciones_de_partes las posiciones de las partes del actor ((ix+0x1D/0x1E) + 8)
L 0xA477 copia_partes copia 3 partes de la ficha (desde ix+0x2C a ix+0x4A)
L 0xA4D7 mueve_1d_1e si no (ix+0x1B): (ix+0x1E) += velocidad X y (ix+0x1D) += velocidad Y
L 0xA546 colores_parpadean dos colores de pieza alternos cada cuadro (0x0B0B / 0x0D0D)
L 0xA615 fotograma_mas_1 (ix+0x10) + 1
L 0xA683 alinea_y la Y del actor al centro de su fila de 8 (+ 4)
L 0xA690 frena_caida si la velocidad Y esta entre 6 y 0x50: 0x600 y sin aceleracion
L 0xA6A6 ciclo_84_87 cada 4 cuadros, el fotograma de 0x84 a 0x87
L 0xA6F9 ciclo_74_77 cada 8 cuadros, el fotograma de 0x74 a 0x77
L 0xA751 sube_hasta_hueco sube de 8 en 8 mientras haya casilla (p02:8BB7); por encima de 0x30 se borra
L 0xA7F6 copia_7c78 copia 16 x 8 de (0x78, 0x10) a (0x7C, 0x78)
L 0xA80A dibujo_a81d copia 16 x 16 de la posicion p03:A81D[A - 1] con TIMP
L 0xA837 hueco_cc60 C = el primer hueco libre de 0xCC60 (4); acarreo si no hay
L 0xA8FC crea_3f crea el actor 0x3F en su posicion con IX = 0xCC3A
L 0xA98A borra_si_no_3e borra el actor de (ix+0x1A/0x1B) si no es de tipo 0x3E
L 0xA9FB borra_tipo_22 borra el primer actor de tipo 0x22
L 0xAA11 orbita cada 2 cuadros, la posicion de p03:AA3C[(ix+0x1F) & 0x0E] alrededor
L 0xAB26 invierte_aceleracion_x (ix+0x0E, 0x0F) = -(ix+0x0E, 0x0F)
L 0xAB7E cambia_posiciones intercambia la posicion (ix+2-5) con la guardada en (ix+0x79-0x7C)
L 0xABD7 jefe_paso p03:ABF5, p03:AC72 y el movimiento de (ix+0x7D)
L 0xABF5 fotograma_45_46 el fotograma 0x45 / 0x46 cada 8 cuadros
L 0xAC25 direccion_siguiente (ix+0x7F) = ((ix+0x7F) + (ix+0x7E)) & 3
L 0xAC2D velocidad_por_direccion (ix+0x7F) = A y las velocidades de p03:AC62[A]
L 0xAC48 paso_por_direccion la posicion + p03:ABED[(ix+0x7F)]
L 0xAC72 mira_direccion la casilla de la direccion siguiente
L 0xAC7C mira_lado 7 casillas de p03:ACB9[(ix+0x7F)]
L 0xACC9 dispara_2c (ix+0x78) - 1; a cero, 0x50 y crea el actor 0x2C
L 0xACDF fotograma_45 (ix+0x10) = 0x45
L 0xAD28 vida_por_ruina la vida del actor + ruina * 16, y (ix+0x1A) igual
L 0xAD3D mira_dano si la vida bajo, (ix+0x19) = 0x10 (parpadeo)
L 0xAD53 parpadeo_de_dano (ix+0x19) - 1 y los colores de pieza de dano
L 0xAE40 velocidad_al_azar H = 1 o 2 al azar, negativo al azar
L 0xAE4F fotograma_47_48 el fotograma 0x47 / 0x48 cada 8 cuadros
L 0xAE5E crea_2d sonido 4 y crea el actor 0x2D
L 0xAEA9 rebota_arriba si se sale por arriba: rebota con velocidad al azar y sonido 0x0A
L 0xAEC9 crea_27_cada (ix+0x1F) - 1; a cero, A y crea el actor 0x27
L 0xB038 colores_a_cero (ix+0x19) = 0 y colores de pieza 0
L 0xB03F tres_colores 3 colores de pieza DE (p03:A54E)
L 0xB098 colores_dca0 colores 7 y 0x48 en 0xDCA0/0xDCC0 + 0x20 - (ix+0x11)
L 0xB0AC dos_colores_de_sprite (HL + A) = 7 y (HL + A + 0x10) = 0x48
L 0xB105 columna_al_azar una X al azar entre 0x48 y 0xA8 y 8 actores en ella
L 0xB2D7 posicion_c2a0 0xC2A0/0xC2A1 = la posicion del personaje con D/E y B
L 0xB321 cuenta_c272 0xC272 - 1; a cero, esconde los sprites de 0xDE20/24 y p00:5ABD
L 0xB38C alterna_c2a2 cada 4 cuadros, 0xC2A2 xor 4
L 0xB39B avanza_c2a1 0xC2A1 + 1 si 0xC2A6 y no se pasa
L 0xB3AE y_c2a0 0xC2A0 + (HL + 0xC2A5)
L 0xB424 personaje_al_actor el personaje en la posicion del actor (Y + 8)
L 0xB446 cerca_en_x_8 acarreo y velocidad X = L si el personaje esta a menos de 8 en X
L 0xB456 cerca_en_y_8 acarreo y velocidad Y = L si el personaje esta a menos de 8 en Y
L 0xB466 sonido_8_cada_16 cada 16 cuadros el sonido 8
L 0xB472 sonido_43_y_fotograma cada 16 cuadros el sonido 0x43; el fotograma B o B + 1 cada 8
L 0xB4DA dibujo_b4da copia (ix+0x11) lineas de (0x88, 0x80) junto al actor (LMMM 0x10)
L 0xB514 dibujo_b514 copia (ix+0x11) lineas a (0x88, 0x80) (LMMM 0x40)
L 0xB55F fotograma_9a_9b el fotograma 0x9A / 0x9B cada 32 cuadros
L 0xB587 dibujo_b587 copia (ix+0x11) lineas de (0x50, 0x98 + B) con TIMP
L 0xB59A posicion_del_dibujo D, E y B para los dibujos de 0x20 - (ix+0x11) lineas
L 0xB5D1 piezas_por_personaje los patrones de las piezas (0x4B o 0x5C) segun el personaje y el fotograma 0x5E
L 0xB6FB pon_c (DE) = C
L 0xB6FE pon_c_2 (DE + 2) = C
L 0xB705 pon_c_1 (DE + 1) = C
L 0xB70A pon_c_3 (DE + 3) = C
L 0xB712 empuja_al_personaje si el actor se mueve, mueve al personaje que va encima
L 0xB756 choques_del_actor plataformas (p03:B8C6), golpes (p03:B95A), pisadas (p03:BA0C) y su tipo
L 0xB7C3 suelo_del_personaje las dos casillas bajo el personaje (p01:704C)
L 0xB8BC alinea_y_del_personaje la Y del personaje a su fila de 8 (+ 3)
L 0xB8C6 plataformas los tipos de p03:B9F7 (7 de 3 bytes) sobre los que se puede estar
L 0xB8E5 encima_de acarreo si el personaje esta encima del actor
L 0xB929 cae_encima si cae (accion 1), lo deja encima del actor
L 0xB95A golpe_al_personaje segun el tipo (1, 3, 7) si toca la caja del personaje
L 0xB9AD toca_caja acarreo si el actor toca la caja del personaje
L 0xBA0C pisa_actor en accion 0 o 2, los tipos 2 y 4 junto al personaje
L 0xBA79 pared_al_empujar las casillas a 6 puntos del personaje al empujarlo
L 0xBAA0 tipo_2_o_negativo segun el tipo, p03:BA7E o p03:BA82
L 0xBC95 espera_de_15 (ix+0x11) = (ix+0x15)
L 0xBE39 copia_hueco_enemigo copia 16 x 24 del hueco del enemigo (p01:780D) a su posicion
L 0xBE4C dibujo_8800 copia 16 x 16 de (0x88, 0) a la posicion del actor con TIMP
L 0xBFE0 tabla_por_estado HL = p03:BFF1[byte 6 del personaje]
